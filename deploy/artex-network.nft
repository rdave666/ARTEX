# Dedicated table only: never flush or modify unrelated firewall rules.
# Localhost is allowed for the recording proxy and on-host diagnostics.
table inet artex {
    chain inbound {
        type filter hook input priority -10; policy accept;
        iifname != "tailscale0" iifname != "lo" tcp dport { 8787, 8788 } counter drop comment "ARTEX: tailnet or localhost only"
    }
}
